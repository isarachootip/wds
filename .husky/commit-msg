#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Regex pattern enforcing requirement ID: [FR-xx-xxx] or [NFR-xx-xxx] or [BR-xxx] or [MIG-xxx]
COMMIT_MSG=$(cat "$1")
PATTERN="^\[(FR-[A-Z]{2}-[0-9]{3}|NFR-[A-Z]{3}-[0-9]{3}|BR-[0-9]{3}|MIG-[0-9]{3})\] .+"

if ! echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  echo "\n\033[31m[ERROR] Commit message rejected!\033[0m"
  echo "Commit messages must start with a bracketed Requirement ID conforming to:"
  echo "  [FR-xx-xxx] <type>(<scope>): <message>"
  echo "Example:"
  echo "  [FR-PR-001] feat(pricing): implement stepped volume break calculation\n"
  exit 1
fi
