# Application Environment
NODE_ENV=development
PORT=3000
TZ=UTC

# PostgreSQL Database (Neon HA with ICU Thai Collation)
DATABASE_URL=postgresql://wds_app_user:wds_secure_pass@localhost:5432/thai_watsadu_wds?schema=public

# Redis Cluster / Single Node (ATP Redlock Mutex)
REDIS_URL=redis://localhost:6379/0

# Apache Kafka Event Streaming
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=wds-monolith-dev
KAFKA_GROUP_ID=wds-order-processors

# Thai Watsadu Statutory Parameters
SELLER_TAX_ID=0107553000107
SELLER_HEADQUARTERS_BRANCH_CODE=00000
SELLER_NAME_TH=บริษัท ซีอาร์ซี ไทวัสดุ จำกัด (มหาชน)
SELLER_NAME_EN=CRC Thai Watsadu Company Limited
DEFAULT_VAT_RATE=0.0700
